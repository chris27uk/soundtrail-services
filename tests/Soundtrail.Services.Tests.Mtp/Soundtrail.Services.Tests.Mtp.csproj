<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <RootNamespace>Soundtrail.Services.Tests.Mtp</RootNamespace>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- Opt-in MTP for dotnet test without changing solution-wide global.json (main pack stays VSTest/xUnit 2). -->
    <TestingPlatformDotnetTestSupport>true</TestingPlatformDotnetTestSupport>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="testconfig.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageReference Include="RavenDB.Client" Version="7.2.5" />
    <PackageReference Include="RavenDB.Embedded" Version="7.2.5" />
    <PackageReference Include="Testcontainers" Version="4.8.1" />
    <PackageReference Include="Testcontainers.ServiceBus" Version="4.8.1" />
    <PackageReference Include="WireMock.Net" Version="2.12.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="3.2.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Soundtrail.Domain\Soundtrail.Domain.csproj" />
    <ProjectReference Include="..\..\src\Soundtrail.Contracts\Soundtrail.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Soundtrail.Services.Api\Soundtrail.Services.Api.csproj" />
    <ProjectReference Include="..\..\src\Soundtrail.Services.Enrichment.Orchestrator\Soundtrail.Services.Enrichment.Orchestrator.csproj" />
    <ProjectReference Include="..\..\src\Soundtrail.Services.Enrichment.Scheduler\Soundtrail.Services.Enrichment.Scheduler.csproj" />
    <ProjectReference Include="..\..\src\Soundtrail.Services.Enrichment.CatalogImport\Soundtrail.Services.Enrichment.CatalogImport.csproj" />
    <ProjectReference Include="..\..\src\Soundtrail.Services.Enrichment.Worker\Soundtrail.Services.Enrichment.Worker.csproj" />
    <ProjectReference Include="..\..\src\Soundtrail.Services.Projector\Soundtrail.Services.Projector.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <!-- Reuse E2E infrastructure from the main test project (not v2 ICollectionFixture types). -->
  <ItemGroup>
    <Compile Include="..\Soundtrail.Services.Tests\EndToEnd\Shared\**\*.cs" Link="Linked\EndToEnd\Shared\%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="..\Soundtrail.Services.Tests\Integration\Shared\Infrastructure\TestInfrastructureException.cs" Link="Linked\Infrastructure\TestInfrastructureException.cs" />
    <Compile Include="..\Soundtrail.Services.Tests\Integration\Shared\Infrastructure\EmbeddedRavenTestServer.cs" Link="Linked\Infrastructure\EmbeddedRavenTestServer.cs" />
    <Compile Include="..\Soundtrail.Services.Tests\Integration\Shared\Infrastructure\LocalRedisTestServer.cs" Link="Linked\Infrastructure\LocalRedisTestServer.cs" />
    <Compile Include="..\Soundtrail.Services.Tests\Integration\Shared\Infrastructure\TestContainerWarmup.cs" Link="Linked\Infrastructure\TestContainerWarmup.cs" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Soundtrail.Services.AppHost\servicebus-emulator\Config.json"
          Link="EndToEnd\Shared\servicebus-emulator\Config.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
