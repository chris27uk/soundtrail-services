<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <!-- Referenced apps each ship appsettings.json; publish flattens to one folder. -->
    <ErrorOnDuplicatePublishOutputFiles>false</ErrorOnDuplicatePublishOutputFiles>
    <!-- Local default: Embedded. CI compose sets false and uses packages.ci.lock.json. -->
    <UseEmbeddedRaven Condition="'$(UseEmbeddedRaven)' == ''">true</UseEmbeddedRaven>
    <DefineConstants Condition="'$(UseEmbeddedRaven)' != 'false'">$(DefineConstants);USE_EMBEDDED_RAVEN</DefineConstants>
    <NuGetLockFilePath Condition="'$(UseEmbeddedRaven)' == 'false'">packages.ci.lock.json</NuGetLockFilePath>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="testconfig.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Integration/**/*.html" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Unit/Solitary/Catalog/MusicBrainzDumpImport/Fixtures/**/*.tar.xz" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentAssertions" Version="8.10.0" />
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="10.0.0" />
    <PackageReference Include="RavenDB.Client" Version="7.2.5" />
    <PackageReference Include="RavenDB.Embedded" Version="7.2.5" Condition="'$(UseEmbeddedRaven)' != 'false'" />
    <PackageReference Include="Testcontainers" Version="4.8.1" />
    <PackageReference Include="WireMock.Net" Version="2.12.0" />
    <PackageReference Include="xunit.v3.mtp-v2" Version="4.0.0-pre.154" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Soundtrail.Domain\Soundtrail.Domain.csproj" />
    <ProjectReference Include="..\..\src\Soundtrail.Contracts\Soundtrail.Contracts.csproj" />
    <ProjectReference Include="..\..\src\Soundtrail.Services.Api\Soundtrail.Services.Api.csproj" />
    <ProjectReference Include="..\..\src\Soundtrail.Services.Enrichment.Orchestrator\Soundtrail.Services.Enrichment.Orchestrator.csproj" />
    <ProjectReference Include="..\..\src\Soundtrail.Services.Enrichment.Scheduler\Soundtrail.Services.Enrichment.Scheduler.csproj" />
    <ProjectReference Include="..\..\src\Soundtrail.Services.Enrichment.CatalogImport\Soundtrail.Services.Enrichment.CatalogImport.csproj" />
    <ProjectReference Include="..\..\src\Soundtrail.Services.Enrichment.Worker\Soundtrail.Services.Enrichment.Worker.csproj" />
    <ProjectReference Include="..\..\src\Soundtrail.Services.Projector\Soundtrail.Services.Projector.csproj" />
    <ProjectReference Include="..\..\src\Soundtrail.Services.StreamBrowser\Soundtrail.Services.StreamBrowser.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="Integration\Features\" />
    <Folder Include="Unit\Sociable\Features\OnDemand\" />
    <Folder Include="Unit\Sociable\Features\Scheduled\" />
    <Folder Include="Unit\Solitary\CrossCutting\" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\Soundtrail.Services.AppHost\servicebus-emulator\Config.json"
          Link="EndToEnd\Shared\servicebus-emulator\Config.json"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
