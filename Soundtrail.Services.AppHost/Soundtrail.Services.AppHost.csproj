<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <UserSecretsId>d90eef79-ea8a-4b0a-b3c4-cf08923d2e4a</UserSecretsId>
        <!--
          Aspire injects host-RID Dashboard/Orchestration packages at restore time.
          Keep a lock file per SDK RID so locked-mode works on macOS and linux CI.
        -->
        <NuGetLockFilePath>packages.$(NETCoreSdkRuntimeIdentifier).lock.json</NuGetLockFilePath>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="AJP.Aspire.Hosting.AsbEmulatorUi" Version="1.0.24" />
      <PackageReference Include="Aspire.Hosting.Azure" Version="13.4.6" />
      <PackageReference Include="Aspire.Hosting.Azure.ServiceBus" Version="13.4.6" />
      <PackageReference Include="MessagePack" Version="3.1.8" />
      <ProjectReference Include="..\src\Soundtrail.Services.Api\Soundtrail.Services.Api.csproj" />
      <ProjectReference Include="..\src\Soundtrail.Services.Enrichment.Scheduler\Soundtrail.Services.Enrichment.Scheduler.csproj" />
      <ProjectReference Include="..\src\Soundtrail.Services.Enrichment.CatalogImport\Soundtrail.Services.Enrichment.CatalogImport.csproj" />
      <ProjectReference Include="..\src\Soundtrail.Services.Enrichment.Orchestrator\Soundtrail.Services.Enrichment.Orchestrator.csproj" />
      <ProjectReference Include="..\src\Soundtrail.Services.Enrichment.Worker\Soundtrail.Services.Enrichment.Worker.csproj" />
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\src\Soundtrail.Services.Projector\Soundtrail.Services.Projector.csproj" />
    </ItemGroup>

</Project>
